def arithmetic_arranger(problems, show_answers=False):
    first_line = []
    second_line = []
    separator_line = []
    result_line = []
    message = ''
    
    #Validation of amount of problems
    if len(problems) > 5:
        message = 'Error: Too many problems.'
        return message
    #Separate each element in the list of problems given
    for element in problems:
        first_num, operator, second_num = element.split()
        #Validation of operator
        if operator not in ["+", "-"]:
            message = "Error: Operator must be '+' or '-'."
            return message
            break
        #Validation of digits
        elif not first_num.isdigit() or not second_num.isdigit():
            message = 'Error: Numbers must only contain digits.'
            return message
            break
        #Calculate max width of the high num , add two spaces,one to operator and other to space
        width = max(len(first_num), len(second_num)) + 2
        #Validation of 4 digits max (add +2 for space and operator in second line)
        if width > 6:
            message = 'Error: Numbers cannot be more than four digits.'
            return message
            break

        line1 = first_num.rjust(width)
        line2 = operator + second_num.rjust(width-1)
        line3 = "-" * width
        #Evaluate results if second parameter is True
        if show_answers:
            if operator == "+":
                result = int(first_num) + int(second_num)
            if operator == "-":
                result = int(first_num) - int(second_num)
            #Add result and apply justify
            result_line.append(str(result).rjust(width))
    

        first_line.append(line1)
        second_line.append(line2)
        separator_line.append(line3)

    final_first_line = "    ".join(first_line)
    final_second_line = "    ".join(second_line)
    final_separator_line = "    ".join(separator_line)
    

    final_format = final_first_line + "\n" + final_second_line + "\n" + final_separator_line
    if show_answers:
        final_format += "\n" + "    ".join(result_line)

    return final_format

print(f'\n{arithmetic_arranger(["32 + 698", "3801 - 2", "45 + 43", "123 + 49"])}')

